{
  "name": "acta",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev:bare",
    "dev:server": "vp run --filter hono dev:bare",
    "db:generate": "vp run --filter @acta/db db:generate",
    "deploy": "vp run --filter @acta/infra deploy",
    "destroy": "vp run --filter @acta/infra destroy",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "fix": "vp check --fix",
    "test": "vp test"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acta/config": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@shadcn/lint": "^0.2.3",
    "@types/node": "catalog:",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "rolldown": "1.2.15",
    "typescript": "catalog:",
    "ultracite": "8.1.0",
    "varlock": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
