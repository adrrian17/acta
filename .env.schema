# Single source for every variable in the monorepo. Each package's .env.schema
# picks only the items it needs, so the web app never sees server secrets.
# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$APP_ENV
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# `alchemy dev` sets ALCHEMY_DEV=true on its child, but the Alchemy CLI forces
# NODE_ENV=production for every command, so the environment is derived from it
# @public @type=boolean @optional
ALCHEMY_DEV=

# @public @type=enum(development, production, test)
APP_ENV=if($ALCHEMY_DEV, development, $NODE_ENV)

# @type=string(minLength=32)
BETTER_AUTH_SECRET=if(forEnv(development), "acta-dev-only-insecure-better-auth-secret")

# @type=url
BETTER_AUTH_URL=if(forEnv(development), "http://localhost:3000")

# @type=url
CORS_ORIGIN=if(forEnv(development), "http://localhost:3001")

GITHUB_CLIENT_ID=if(forEnv(development), "acta-dev-github-client-id")

GITHUB_CLIENT_SECRET=if(forEnv(development), "acta-dev-github-client-secret")

# The Owner's numeric GitHub account ID; every other GitHub account is rejected
# @type=string(matches=regex("^[1-9][0-9]*$")) @sensitive={allowShortValue=true}
OWNER_GITHUB_ID=if(forEnv(development), "999999999999999999")

# @public @type=url
VITE_SERVER_URL=if(forEnv(development), "http://localhost:3000")

# @optional
ALCHEMY_PASSWORD=
