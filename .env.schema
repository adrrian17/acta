# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$VARLOCK_ENV
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=if(forEnv(development, test), "local-placeholder-auth-secret-not-for-deploy", "")

# @type=url
BETTER_AUTH_URL=if(forEnv(development, test), "http://localhost:3000", "")

# @type=url
CORS_ORIGIN=if(forEnv(development, test), "http://localhost:3001", "")

GITHUB_CLIENT_ID=if(forEnv(development, test), "local-placeholder-client-id", "")

GITHUB_CLIENT_SECRET=if(forEnv(development, test), "local-placeholder-client-secret", "")

# The Owner's numeric GitHub account ID (adrrian17); every other GitHub account is rejected
# @type=string(matches=regex("^[1-9][0-9]*$")) @sensitive={allowShortValue=true}
OWNER_GITHUB_ID=737252

# @public @type=url
VITE_SERVER_URL=if(forEnv(development, test), "http://localhost:3000", "")

# The account's workers.dev subdomain, without .workers.dev.
# @public @required=forEnv(preview, production) @type=string(matches=regex("^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"))
CLOUDFLARE_WORKERS_SUBDOMAIN=
