# Single source for every variable in the monorepo. Each package's .env.schema
# picks only the items it needs, so the web app never sees server secrets.
# Values go in the root .env (gitignored).
# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

GITHUB_CLIENT_ID=

GITHUB_CLIENT_SECRET=

# The Owner's numeric GitHub account ID; every other GitHub account is rejected
# @type=string(matches=regex("^[1-9][0-9]*$")) @sensitive={allowShortValue=true}
OWNER_GITHUB_ID=

# @public @type=url
VITE_SERVER_URL=

# @optional
ALCHEMY_PASSWORD=
