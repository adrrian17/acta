{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "vp pack",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@acta/api": "workspace:*",
    "@acta/auth": "workspace:*",
    "@acta/db": "workspace:*",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "evlog": "^2.33.1",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acta/config": "workspace:*",
    "@acta/infra": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
