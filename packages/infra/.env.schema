# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=true)
# @import(../../, pick=[NODE_ENV, CORS_ORIGIN, BETTER_AUTH_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, OWNER_GITHUB_ID, ALCHEMY_PASSWORD])
# ---

# @type=opServiceAccountToken @sensitive @required=forEnv(production)
OP_TOKEN=

# @public @required=forEnv(production)
OP_VAULT_NAME=

# @public @required=forEnv(production)
CLOUDFLARE_ACCOUNT_ID=

# @sensitive
CLOUDFLARE_API_TOKEN=op(op://${OP_VAULT_NAME}/github-actions/CLOUDFLARE_API_TOKEN)

# @sensitive
BETTER_AUTH_SECRET=op(op://${OP_VAULT_NAME}/github-actions/BETTER_AUTH_SECRET)

# @sensitive
CORS_ORIGIN=op(op://${OP_VAULT_NAME}/github-actions/CORS_ORIGIN)

# @sensitive
OWNER_GITHUB_ID=op(op://${OP_VAULT_NAME}/github-actions/OWNER_GITHUB_ID)

# @sensitive
GITHUB_CLIENT_ID=op(op://${OP_VAULT_NAME}/github-actions/GITHUB_CLIENT_ID)

# @sensitive
GITHUB_CLIENT_SECRET=op(op://${OP_VAULT_NAME}/github-actions/GITHUB_CLIENT_SECRET)
